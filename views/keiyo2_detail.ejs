
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %> の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>駅コード</td><td><%= data.code %></td></tr>
    <tr><td>駅名</td><td><%= data.name %></td></tr>
    <tr><td>乗り換え線</td><td><%= data.change %></td></tr>
    <tr><td>乗客数</td><td><%= data.passengers == null ? '未登録' : data.passengers %></td></tr>
    <tr><td>東京駅からの距離</td><td><%= data.distance == null ? '未登録' : data.distance %></td></tr>
  </table>
  <a href="/keiyo2/edit/<%= number %>">駅情報を変更</a>
  <a href="/keiyo2/delete/<%= number %>">駅を削除</a>
  <a href="/keiyo2">駅一覧に戻る</a>
</body>
</html>
